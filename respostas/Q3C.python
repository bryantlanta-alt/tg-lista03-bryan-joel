from datetime import datetime

# Identificação
print("Aluno: Joel Carlos Assunção Padilha e Bryan Atlanta Cruz")
print("Execução:", datetime.now().strftime("%d/%m/%Y %H:%M:%S"))
print("-" * 35)

INF = float("inf")
V = 6
dist = [
    [0, 4, 2, INF, INF, INF],
    [INF, 0, 3, 2, INF, INF],
    [INF, INF, 0, 4, 5, INF],
    [INF, INF, INF, 0, 1, 6],
    [INF, INF, INF, INF, 0, 2],
    [INF, INF, INF, INF, INF, 0],
]

for k in range(V):
    for i in range(V):
        for j in range(V):
            if dist[i][k] + dist[k][j] < dist[i][j]:
                dist[i][j] = dist[i][k] + dist[k][j]

print("Matriz Final de Distâncias:")
for row in dist:
    print([int(x) if x != INF else "INF" for x in row])
